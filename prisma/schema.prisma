// Esse arquivo descreve TODAS as tabelas do banco e como elas se relacionam.
// Depois de editar, rode: npx prisma migrate dev --name nome_da_mudanca
// Isso cria/atualiza as tabelas reais no banco de dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // troque para "mysql" se preferir MySQL
  url      = env("DATABASE_URL")
}

model Usuario {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  senhaHash   String
  criadoEm    DateTime    @default(now())
  treinadores Treinador[]
}

model Jogo {
  id        Int      @id @default(autoincrement())
  nome      String   // ex: "Pokémon Fire Red"
  geracao   Int?     // ex: 3
  ehHackRom Boolean  @default(false)
  times     Time[]
}

model Treinador {
  id        Int      @id @default(autoincrement())
  nome      String   // nome do treinador dentro do jogo
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  times     Time[]
}

model Time {
  id          Int       @id @default(autoincrement())
  treinadorId Int
  treinador   Treinador @relation(fields: [treinadorId], references: [id])
  jogoId      Int
  jogo        Jogo      @relation(fields: [jogoId], references: [id])
  dataZerou   DateTime?
  pokemons    Pokemon[]
}

model Pokemon {
  id           Int           @id @default(autoincrement())
  timeId       Int
  time         Time          @relation(fields: [timeId], references: [id])
  especie      String        // ex: "Charizard"
  apelido      String?       // nickname, opcional
  nature       String        // ex: "Adamant"
  nivel        Int           // nível em que estava ao zerar o jogo
  habilidade   String?
  itemSegurado String?
  moves        PokemonMove[]
}

model Move {
  id           Int           @id @default(autoincrement())
  nome         String        @unique // ex: "Flamethrower"
  tipo         String        // ex: "Fogo", "Água", "Elétrico"
  categoria    String        // "Físico", "Especial" ou "Status"
  poder        Int?          // dano base (nulo se for move de Status)
  precisao     Int?          // porcentagem de acerto
  descricao    String?       // o que o move faz
  pokemonMoves PokemonMove[]
}

// Tabela intermediária: liga um Pokémon específico do time a um Move,
// guardando em qual "slot" (posição 1 a 4) o move está.
model PokemonMove {
  id        Int     @id @default(autoincrement())
  pokemonId Int
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id])
  moveId    Int
  move      Move    @relation(fields: [moveId], references: [id])
  slot      Int     // 1, 2, 3 ou 4

  @@unique([pokemonId, slot]) // um pokémon não pode ter dois moves no mesmo slot
}
