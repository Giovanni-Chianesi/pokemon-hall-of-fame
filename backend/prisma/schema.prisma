datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id        String   @id @default(uuid())
  title     String
  isHackRom Boolean  @default(false)
  teams     Team[]
}

model Team {
  id          String        @id @default(uuid())
  trainerName String
  notes       String?
  completedAt DateTime      @default(now())
  gameId      String
  game        Game          @relation(fields: [gameId], references: [id])
  pokemons    TeamPokemon[]
}

model TeamPokemon {
  id              String        @id @default(uuid())
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pokedexNumber   Int
  pokemonName     String
  nickname        String?
  level           Int
  nature          String
  ability         String?
  heldItem        String?
  customSpriteUrl String?
  slotPosition    Int
  moves           PokemonMove[]
}

model PokemonMove {
  id            String      @id @default(uuid())
  teamPokemonId String
  teamPokemon   TeamPokemon @relation(fields: [teamPokemonId], references: [id], onDelete: Cascade)
  moveName      String
  slot          Int
}